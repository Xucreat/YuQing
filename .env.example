# ===== Bocha auxiliary search leads =====
# Environment-only. Never store this key in the database, data_sources.config_json, logs, or frontend state.
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1
BOCHA_TIMEOUT=10
BOCHA_SEARCH_COUNT=8
# Optional separate credential for AI Search. If empty, BOCHA_API_KEY is reused.
BOCHA_AI_API_KEY=
BOCHA_AI_BASE_URL=https://api.bocha.cn/v1
BOCHA_AI_TIMEOUT=30
BOCHA_AI_SEARCH_COUNT=20
BOCHA_AI_WEIBO_DOMAINS=weibo.com|m.weibo.cn
BOCHA_AI_XIAOHONGSHU_DOMAINS=xiaohongshu.com|xhslink.com

# ===== Anspire web search =====
ANSPIRE_ENABLED=false
ANSPIRE_API_KEY=
